{
  "manifest_version": 3,
  "name": "Mirrored — ver juntos",
  "version": "0.2.0",
  "description": "Sincroniza la reproducción de vídeo en cualquier web con otras personas.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Mirrored", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
